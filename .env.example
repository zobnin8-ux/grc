# GRC intake wiring for the contact form (/api/lead).
# Copy to .env.local for local dev, and set the same vars in Vercel project settings.

# GRC intake endpoint (Supabase Edge Function). Default already points to prod.
INTAKE_URL=https://kuuxaubnbwbwjdttvhom.supabase.co/functions/v1/intake

# Shared secret. MUST match the INTAKE_TOKEN secret set on the Supabase intake function.
# Server-side only — never exposed to the browser. Leave empty only while intake has no token.
INTAKE_TOKEN=
